<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.graduation</groupId>
    <artifactId>mentor-comment-backend</artifactId>
    <version>1.0.0</version>
    <name>mentor-comment-backend</name>
    <description>基于Web的学业导师智能点评分析系统 - 后端</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <sa-token.version>1.37.0</sa-token.version>
        <hanlp.version>portable-1.8.4</hanlp.version>
        <spring-ai.version>1.0.0</spring-ai.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 持久层：MyBatis-Plus + MySQL -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 演示用内存库：无需安装 MySQL 也能把系统跑起来（demo profile） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 鉴权：Sa-Token -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- 中文分词：HanLP portable（自带词典，离线可用） -->
        <dependency>
            <groupId>com.hankcs</groupId>
            <artifactId>hanlp</artifactId>
            <version>${hanlp.version}</version>
        </dependency>

        <!--
            大模型摘要：Spring AI（仅核心模块，不引 starter）。

            为什么不引 spring-ai-starter-model-openai：
            1) 该 starter 的自动配置绑定 Spring Boot 3.4.x，本项目是 3.2.5，启动会因
               AutoConfiguration.imports 里的类找不到而失败；
            2) 自动配置在「无 api-key」时直接抛异常，等于把"没配 Key"变成"服务起不来"。
               本项目的红线是：AI 是可选增强，断网 / 无 Key / 模型超时都必须能正常启动并
               自动回落到规则实现（见 service/ai/LlmSummarySuggester 的懒初始化）。

            webflux 只用于提供 WebClient.Builder —— OpenAiApi.Builder.build() 强制要求它非空，
            即使只走同步 RestClient 调用。项目仍以 Servlet（spring-boot-starter-web）运行。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <!-- ChatClient（高层 fluent API）在独立模块里，spring-ai-openai 不传递依赖它 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- 密码哈希：BCrypt（仅取 spring-security-crypto，不引入整套 Security 过滤器链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                格式：交给 Spotless 自动修复，不做人工争论。
                AOSP 风格 = 4 空格缩进，与本项目现有代码一致；google 风格是 2 空格，会全量重排。
                首次执行 `mvn spotless:apply` 会产生大面积 diff，务必单独一个 chore 提交，
                并把该提交加入 .git-blame-ignore-revs，否则 git blame 全部指向格式化提交。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.22.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                语义检查：只保留"真出过事"的规则（见 config/checkstyle/checkstyle.xml）。
                格式类问题由 Spotless 负责，这里不重复报错。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <!--
                        suppressions.xml 通过 ${config_loc} 引用。
                        这里刻意用相对路径而不是 ${project.basedir}：
                        项目所在目录含中文时，属性展开会按平台编码转换，
                        导致路径被破坏（表现为 "D:\¡Á???\..."）。
                        相对路径由 checkstyle 按当前工作目录解析，
                        Maven 在 backend/ 下执行，CI 也已声明 working-directory: backend。
                    -->
                    <propertyExpansion>config_loc=config/checkstyle</propertyExpansion>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
